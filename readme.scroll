     <defs>
      <linearGradient id="chrome" x1="0" y1="0" x2="400" y2="650" gradientUnits="userSpaceOnUse"><stop stop-color="#fff"/><stop offset=".15" stop-color="#b8b9b7"/><stop offset=".27" stop-color="#fbfbf7"/><stop offset=".6" stop-color="#999b99"/><stop offset=".83" stop-color="#eee"/><stop offset="1" stop-color="#858780"/></linearGradient>
      <linearGradient id="ivory" x1="80" y1="0" x2="350" y2="650" gradientUnits="userSpaceOnUse"><stop stop-color="#fffefa"/><stop offset=".55" stop-color="#f4f4ed"/><stop offset="1" stop-color="#dfdfd8"/></linearGradient>
