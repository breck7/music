css
 * { box-sizing: border-box; }
 :root { color-scheme: light; --ink: #263124; --lcd: #c0cda5; }
 html { min-height:100%; background:#afa28c; }
 body { margin:0; min-height:100svh; font-family:Arial,Helvetica,sans-serif; color:#f8f5eb; background:linear-gradient(90deg,rgba(22,26,21,.37),rgba(22,26,21,.04) 55%,rgba(22,26,21,.17)),url('bg.jpg') center 42% / cover fixed; }
 body::before { content:''; position:fixed; inset:0; background:linear-gradient(0deg,rgba(22,26,21,.5),transparent 24%,transparent 83%,rgba(22,26,21,.2)); pointer-events:none; }
 a { color:inherit; text-decoration:none; }
 a:hover { text-decoration:underline; text-underline-offset:4px; }
 body .abstractIconButtonParser svg { fill: rgba(248,245,235,.85); transition:fill .18s; }
 body .abstractIconButtonParser:hover svg { fill:#fff; }
 .masthead,.footer { position:relative; display:flex; align-items:center; justify-content:space-between; padding:32px 4vw; gap:16px; font-size:10px; letter-spacing:1.7px; }
 .masthead a { font-size:14px; font-weight:700; letter-spacing:3px; }
 .edition { opacity:.85; }
 .stage { position:relative; min-height:100svh; display:grid; grid-template-columns:1fr 1fr; align-items:center; padding:26px 10vw 36px 7vw; gap:40px; }
 .introduction { align-self:end; padding-bottom:68px; text-shadow:0 2px 25px #3e3c34; }
 .eyebrow { font-size:10px; letter-spacing:3px; }
 h1 { font-family:Georgia,'Times New Roman',serif; font-size:clamp(38px,5vw,76px); font-weight:400; letter-spacing:-3px; line-height:1.03; margin:17px 0; }
 .introduction p { font-size:13px; letter-spacing:.2px; opacity:.88; }
 .player { justify-self:end; width:min(360px,100%); }
 .ipod { position:relative; width:100%; aspect-ratio:400 / 650; filter:drop-shadow(10px 30px 28px #171b1955); }
 .shell { display:block; width:100%; height:100%; }
 .screen { position:absolute; left:12.5%; top:9.23%; width:75%; height:38.6%; background:var(--lcd); color:var(--ink); border-radius:4px; box-shadow:inset 1px 3px 8px #26312465; padding:7px 7px 5px; font-family:'Courier New',monospace; display:flex; flex-direction:column; overflow:hidden; }
 .screen::after { content:''; position:absolute; inset:0; pointer-events:none; opacity:.10; background:repeating-linear-gradient(0deg,transparent,transparent 2px,#475840 3px); }
 .statusbar { display:flex; justify-content:space-between; align-items:center; font-weight:bold; font-size:14px; border-bottom:2px solid var(--ink); padding:0 4px 4px; }
 .statusbar span:last-child { border:1px solid var(--ink); line-height:10px; padding:0 2px; font-size:13px; margin-right:3px; position:relative; }
 .statusbar span:last-child::after { content:''; position:absolute; right:-4px; top:2px; width:2px; height:6px; background:var(--ink); }
 .songs { flex:1; min-height:0; overflow-y:auto; overscroll-behavior:contain; scrollbar-width:thin; scrollbar-color:#526148 #abbc94; padding:3px 0; }
 button { font:inherit; cursor:pointer; -webkit-tap-highlight-color:transparent; }
 .song { width:100%; display:block; text-align:left; border:0; color:inherit; background:transparent; padding:5px 7px; position:relative; line-height:1.1; text-decoration:none; cursor:pointer; }
 .song-title { display:block; font-size:12px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; padding-right:8px; }
 .song-artist { display:block; font-size:9px; padding-top:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
 .song:hover,.song.selected { background:var(--ink); color:var(--lcd); }
 .song.selected::after { content:'›'; position:absolute; right:5px; top:4px; font-size:20px; }
 button:focus-visible,a:focus-visible,input:focus-visible { outline:2px solid currentColor; outline-offset:2px; }
 .song:focus-visible { outline-offset:-2px; }
 .now { border-top:1px solid #526148; padding:5px 3px 0; flex-shrink:0; }
 #now-title { display:block; font-size:10px; font-weight:bold; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
 #now-detail { display:block; font-size:9px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin:3px 0; }
 #seek { width:100%; height:10px; margin:0; accent-color:var(--ink); display:block; cursor:pointer; }
 .times { display:flex; justify-content:space-between; font-size:9px; margin-top:3px; }
 .wheel-touch { position:absolute; left:22%; top:54.1%; width:56%; height:34.5%; border-radius:50%; touch-action:none; }
 .ipod > button { position:absolute; border:0; background:transparent; color:#5c655a; border-radius:50%; padding:0; }
 .ipod > button:active { background:#909d861c; box-shadow:inset 0 1px 5px #0001; }
 .repeat { left:40%; top:55%; width:20%; height:8%; }
 .previous { left:23%; top:66%; width:16%; height:12%; }
 .next { right:23%; top:66%; width:16%; height:12%; }
 .toggle { left:40%; top:80%; width:20%; height:8%; }
 .shuffle { left:37%; top:63.7%; width:26%; height:16%; }
 .repeat-glyph { opacity:.3; transition:opacity .18s; }
 .repeat-glyph.on { opacity:1; }
 .repeat-one { display:none; }
 .repeat-one.on { display:inline; }
 #repeat-flag { font-size:12px; }
 .hint { text-align:center; font-size:10px; letter-spacing:1.2px; margin:22px 0 0; text-shadow:0 2px 10px #222; }
 .footer { padding-top:16px; padding-bottom:22px; font-size:9px; letter-spacing:1px; }
 .photo-credit { font-size:8px; opacity:.75; }
 @media(min-width:1500px) { .player { width:400px; } }
 @media(max-width:700px) { body { background-position:45% 40%; } .masthead { padding:24px; } .edition { display:none; } .stage { min-height:auto; display:flex; flex-direction:column; gap:22px; padding:20px 24px 28px; } .introduction { align-self:center; padding:0; text-align:center; } h1 { font-size:40px; margin:10px 0; letter-spacing:-1.5px; } .introduction p { display:none; } .eyebrow { font-size:8px; } .player { width:min(340px,100%); } .footer { padding:18px 24px; justify-content:center; text-align:center; } .photo-credit { display:none; } }
 @media(prefers-reduced-motion:no-preference) { .player { animation:drop-in .9s cubic-bezier(.22,1,.36,1) both; } @keyframes drop-in { from { transform:translateY(calc(-100vh - 100%)); } to { transform:translateY(0); } } }

catalog.js
script
 document.getElementById("songs").innerHTML = catalog.map(song => `
   <a class="song"
     href="${encodeURIComponent(song.file)}"
     data-file="${song.file}"
     data-artist="${song.artist}"
     data-title="${song.title}"
     data-song="${song.id}"
     data-year="${song.year}"
     data-duration="${song.duration}">
     <span class="song-title">${song.title}</span>
     <span class="song-artist">${song.artist}</span>
   </a>
 `).join("");

script
 (() => {
   const $ = id => document.getElementById(id);
   const list = $('songs');
   const songs = [...list.querySelectorAll('.song')];
   const audio = new Audio();
   audio.preload = 'metadata';
   let selected = 0, current = -1, request = 0, pendingSeek = null, autoplayBlocked = false;
   function updateLink() {
     if (current < 0 || pendingSeek !== null) return;
     const hash = '#'+new URLSearchParams({song:songs[current].dataset.song, t:String(Math.floor(audio.currentTime || 0))});
     if (location.hash !== hash) history.replaceState(null, '', location.pathname + location.search + hash);
   }
   function applySeek() {
     if (pendingSeek === null || !Number.isFinite(audio.duration)) return;
     pendingSeek = Math.max(0, Math.min(pendingSeek, Math.max(0, audio.duration - .1)));
     if (!audio.seekable.length || audio.seekable.end(audio.seekable.length - 1) < pendingSeek) return;
     audio.currentTime = pendingSeek;
   }
   function seekTo(seconds) {
     pendingSeek = seconds;
     audio.preload = 'auto';
     applySeek();
   }
   function openLink() {
     const hash = new URLSearchParams(location.hash.slice(1));
     const params = hash.has('song') ? hash : new URLSearchParams(location.search);
     const index = songs.findIndex(song => song.dataset.song === params.get('song'));
     if (index < 0) return;
     const raw = params.get('t') || '0';
     const seconds = /^(?:\d+:){0,2}\d+(?:\.\d+)?$/.test(raw) ? raw.split(':').reduce((total, part) => total * 60 + Number(part), 0) : 0;
     play(index, Number.isFinite(seconds) ? seconds : 0);
   }
   const time = n => `${Math.floor((n || 0) / 60)}:${String(Math.floor((n || 0) % 60)).padStart(2, '0')}`;
   $('now-title').setAttribute('aria-live', 'polite');
   function highlight(index, scroll = true) {
     selected = Math.max(0, Math.min(songs.length - 1, index));
     songs.forEach((button, i) => { button.classList.toggle('selected', i === selected); button.setAttribute('aria-current', i === current ? 'true' : 'false'); });
     if (scroll) songs[selected].scrollIntoView({block:'nearest', behavior:'instant'});
   }
   function render() {
     if (current < 0) return;
     const s = songs[current].dataset;
     $('now-title').textContent = `${audio.paused ? 'Ⅱ' : '▶'} ${s.title}`;
     $('now-detail').textContent = autoplayBlocked ? 'Press play to start here' : `${s.artist} · ${s.year}`;
     $('toggle').setAttribute('aria-label', audio.paused ? 'Play' : 'Pause');
   }
   async function play(index, startTime = null) {
     if (index < 0 || index >= songs.length) return;
     const token = ++request;
     autoplayBlocked = false;
     if (startTime === null && current === index && !audio.paused) { audio.pause(); return; }
     if (current !== index) {
       pendingSeek = startTime;
       current = index;
       audio.src = new URL(encodeURIComponent(songs[index].dataset.file), location.href).href;
       $('seek').value = 0;
       $('elapsed').textContent = '0:00';
     }
     if (startTime !== null) seekTo(startTime);
     highlight(index); render(); updateLink();
     try { await audio.play(); if(token === request) render(); }
     catch(error) { if(token !== request || error.name === 'AbortError') return; if(error.name === 'NotAllowedError') { autoplayBlocked = true; render(); } else { $('now-title').textContent = 'Could not play this file'; $('now-detail').textContent = 'Select a song to try again'; } }
   }
   songs.forEach((link, i) => link.addEventListener('click', e => { e.preventDefault(); play(i); }));
   const repeatModes = [
     { label: 'Repeat off', flag: '' },
     { label: 'Repeat all songs', flag: '↻ ALL' },
     { label: 'Repeat this song', flag: '↻ 1' },
   ];
   let repeat = 0, repeatTimer;
   function applyRepeat() {
     const mode = repeatModes[repeat];
     $('repeat').setAttribute('aria-label', `${mode.label}; press to change`);
     $('repeat-flag').textContent = mode.flag;
     document.querySelector('.repeat-glyph').classList.toggle('on', repeat > 0);
     document.querySelector('.repeat-one').classList.toggle('on', repeat === 2);
   }
   $('repeat').onclick = () => {
     repeat = (repeat + 1) % repeatModes.length;
     applyRepeat();
     $('now-detail').textContent = repeatModes[repeat].label;
     clearTimeout(repeatTimer);
     repeatTimer = setTimeout(() => { if (current < 0) $('now-detail').textContent = 'Select a song to play'; else render(); }, 1600);
   };
   applyRepeat();
   $('toggle').onclick = () => play(current < 0 ? selected : current);
   $('next').onclick = () => play((current + 1) % songs.length);
   $('previous').onclick = () => { if(audio.currentTime > 3) audio.currentTime = 0; else play((current <= 0 ? songs.length : current) - 1); };
   $('shuffle').onclick = () => { const choices = songs.map((_, i) => i).filter(i => i !== current); play(choices[Math.floor(Math.random() * choices.length)] ?? 0); };
   $('seek').addEventListener('input', e => { if(Number.isFinite(audio.duration)) seekTo(Number(e.target.value) / 1000 * audio.duration); });
   audio.addEventListener('timeupdate', () => {
     const duration = Number.isFinite(audio.duration) ? audio.duration : Number(songs[current]?.dataset.duration || 0);
     $('seek').value = duration ? audio.currentTime / duration * 1000 : 0;
     $('elapsed').textContent = time(audio.currentTime);
     $('remaining').textContent = `−${time(Math.max(0,duration - audio.currentTime))}`;
     updateLink();
   });
   ['loadedmetadata','durationchange','progress','canplay'].forEach(event => audio.addEventListener(event, applySeek));
   audio.addEventListener('seeked', () => { if(pendingSeek !== null && Math.abs(audio.currentTime - pendingSeek) < .5) { pendingSeek = null; updateLink(); } });
   audio.addEventListener('pause', updateLink);
   ['play','pause','loadedmetadata'].forEach(event => audio.addEventListener(event, render));
   audio.addEventListener('error', () => { $('now-title').textContent = 'Unable to load song'; $('now-detail').textContent = 'Check that the music file is available'; });
   audio.addEventListener('ended', () => { if(repeat === 2) play(current, 0); else if(current < songs.length - 1) play(current + 1); else if(repeat === 1) play(0); else render(); });
   let wheelDelta = 0;
   const wheel = $('wheel');
   document.querySelector('.ipod').addEventListener('wheel', e => {
     if(list.contains(e.target)) return;
     e.preventDefault(); wheelDelta += e.deltaY;
     if(Math.abs(wheelDelta) > 28) { highlight(selected + Math.sign(wheelDelta)); wheelDelta = 0; }
   }, {passive:false});
   let angle = null, rotation = 0;
   const pointerAngle = e => { const r=wheel.getBoundingClientRect(); return Math.atan2(e.clientY-r.top-r.height/2,e.clientX-r.left-r.width/2); };
   wheel.addEventListener('pointerdown', e => { angle=pointerAngle(e); rotation=0; wheel.setPointerCapture(e.pointerId); });
   wheel.addEventListener('pointermove', e => {
     if(angle === null) return;
     const next=pointerAngle(e); let delta=next-angle;
     if(delta > Math.PI) delta-=2*Math.PI; if(delta < -Math.PI) delta+=2*Math.PI;
     rotation+=delta; angle=next;
     if(Math.abs(rotation) > .35) { highlight(selected + Math.sign(rotation)); rotation=0; }
   });
   ['pointerup','pointercancel','lostpointercapture'].forEach(event => wheel.addEventListener(event, () => angle=null));
   document.querySelector('.player').addEventListener('keydown', e => {
     if(e.target === $('seek')) return;
     if(e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); highlight(selected + (e.key === 'ArrowDown' ? 1 : -1)); songs[selected].focus({preventScroll:true}); }
     if(e.code === 'Space' && e.target.tagName !== 'BUTTON') { e.preventDefault(); play(current < 0 ? selected : current); }
   });
   highlight(0, false);
   window.addEventListener('hashchange', openLink);
   openLink();
 })();


